								}
							}
						}
					],
					"documentation": "Abstract actor: generalization of all role actors. Owns the common Log In goal. One real person may play several roles (e.g. an instructor who is also a coordinator).",
					"isAbstract": true
				},
				{
					"_type": "UMLActor",
					"_id": "AAAAAAABbA6A",
					"_parent": {
						"$ref": "AAAAAAABEyze"
					},
					"name": "Student",
